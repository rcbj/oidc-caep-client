{
  "name": "oidc-caep-client",
  "version": "0.2.0",
  "description": "In-browser OpenID Connect public client (PKCE, PAR, DPoP, RFC 9207) with token caching/auto-refresh and a Shared Signals (SSF) / CAEP event receiver",
  "homepage": "https://rcbj.github.io/oidc-caep-client/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcbj/oidc-caep-client.git",
    "directory": "packages/oidc-caep-client"
  },
  "bugs": {
    "url": "https://github.com/rcbj/oidc-caep-client/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "src",
    "types",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "build:types": "tsc -p tsconfig.json",
    "test:types": "node test/types/extract-doc-examples.mjs && tsc -p test/types/tsconfig.json",
    "prepack": "npm run build:types"
  },
  "keywords": [
    "browser",
    "caep",
    "dpop",
    "oauth2",
    "oidc",
    "openid",
    "par",
    "pkce",
    "public-client",
    "risc",
    "secevent",
    "shared-signals",
    "ssf"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24.22.1"
  },
  "dependencies": {
    "jose": "^6.2.12"
  },
  "author": "Iya CyberSecurity Solutions, LLC",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
